{
  "name": "earthquake-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Production-oriented earthquake ingestion, analysis, visualization, and chat platform",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @earthquake/api --filter @earthquake/dashboard dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @earthquake/ingestion migrate",
    "infra:synth": "pnpm --filter @earthquake/infrastructure synth",
    "series:classify": "pnpm --filter @earthquake/ingestion classify",
    "ingest:backfill": "pnpm --filter @earthquake/ingestion backfill",
    "ingest:poll": "pnpm --filter @earthquake/ingestion poll"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
