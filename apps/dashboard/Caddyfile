{$SITE_ADDRESS} {
	encode zstd gzip

	@api path /v1/*
	handle @api {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
